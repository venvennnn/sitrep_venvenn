# Copy to .env and fill in.

# Signing secret from the SitRep Studio (shown once when you save a Remote agent).
# Leave blank for pure local dev — signature checks are skipped when unset.
SITREP_AGENT_SECRET=

# Optional: pin glossary memory to a workspace (overrides attendees hash).
# You can also set `workspace: your-id` in Studio agent instructions.
DRIFTGUARD_WORKSPACE=

# Optional: durable path for the living glossary DB (use a persistent disk in prod).
# DRIFTGUARD_DB_PATH=/var/data/glossary.db

# ── LLM: defaults to a free local Ollama. No signup, no cost. ──────────
#   1) install:  https://ollama.com
#   2) pull:     ollama pull llama3.2:1b
LLM_BASE_URL=http://localhost:11434/v1
MODEL=llama3.2:1b
# LLM_API_KEY is unused by Ollama.

# ── BYOK alternatives (uncomment one) ─────────────────────────────────
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# MODEL=gpt-4o-mini
#
# OpenRouter (has free models — slugs change often):
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# MODEL=openrouter/free
# Alternatives if openrouter/free is busy:
# MODEL=openai/gpt-oss-20b:free
# MODEL=nvidia/nemotron-nano-9b-v2:free
# Browse: https://openrouter.ai/models?q=free
